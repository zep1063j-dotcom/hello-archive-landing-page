# =========================================================
# Hello_Archive 랜딩페이지 — Git에 올리지 않을 파일
# =========================================================

# ---------- 운영체제가 자동으로 만드는 파일 ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- 편집기 / IDE 설정 ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 비밀 정보 (절대 올리면 안 됨) ----------
# 나중에 신청 폼·Supabase 등을 연결할 때 생길 수 있는 키 파일
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
config.local.*

# ---------- 패키지 / 빌드 결과물 ----------
# 지금은 사용하지 않지만, 도구를 추가할 경우 대비
node_modules/
dist/
build/
.cache/
.parcel-cache/

# ---------- 로그 / 임시 파일 ----------
*.log
npm-debug.log*
*.tmp
*.bak

# ---------- 테스트·점검 결과물 ----------
# Lighthouse 보고서, 스크린샷 등 작업 중 만든 파일
lighthouse-report*
*.lighthouse.*
screenshots/
